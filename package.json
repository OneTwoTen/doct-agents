{
  "name": "doct-agents",
  "version": "0.3.0",
  "description": "Install and manage DOCT custom agents for GitHub Copilot and OpenCode.",
  "type": "module",
  "bin": {
    "doct-agents": "bin/cli.js"
  },
  "files": [
    "agents",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.mjs",
    "test:python": "python -m unittest discover -s tests -v",
    "validate": "python scripts/validate_agents.py",
    "pack:check": "npm pack --dry-run",
    "smoke:package": "node scripts/smoke_package.mjs",
    "release:check": "python scripts/check_release.py",
    "check": "npm test && npm run test:python && npm run validate && npm run pack:check && npm run smoke:package"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "vscode",
    "copilot",
    "opencode",
    "agents",
    "custom-agents",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OneTwoTen/doct-agents.git"
  },
  "homepage": "https://github.com/OneTwoTen/doct-agents#readme",
  "bugs": {
    "url": "https://github.com/OneTwoTen/doct-agents/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
